{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-paktia-gateway",
  "main": "workers/gateway/src/index.ts",
  "compatibility_date": "2026-10-15",
  "vars": {
    "GAME_ENV": "development",
    "PUBLIC_GAME_VERSION": "0.1.0"
  },
  "r2_buckets": [
    {
      "binding": "GAME_ASSETS",
      "bucket_name": "project-paktia-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GAME_JOBS",
        "queue": "project-paktia-jobs"
      }
    ]
  }
}
